    "@types/node": "24.10.0",
    "@types/three": "0.180.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.1.12",
    "vitest": "^3.2.4"
  }
}
